# Copy to .env and fill in. Never commit a populated .env.

OPENBIS_URL=https://openbis.imm.rwth-aachen.de

# Preferred: personal access token (PAT) created in the openBIS web UI
# under: User -> Personal Access Tokens
OPENBIS_TOKEN=

# Alternative: path to a file containing the token on its own line.
# Matches the pyBIS convention of ~/.pybis/<host>.token. Used only if
# OPENBIS_TOKEN is empty.
# OPENBIS_TOKEN_FILE=~/.pybis/openbis.imm.rwth-aachen.de.token

# Fallback: username + password (only used if no token is available)
# OPENBIS_USERNAME=
# OPENBIS_PASSWORD=

# Set to "false" only for development against a self-signed cert.
OPENBIS_VERIFY_CERTIFICATES=true

# Enable create / update / delete tools. OFF by default — the server runs
# read-only unless this is explicitly set to "1".
# OPENBIS_MCP_ALLOW_WRITE=1

# ---------------------------------------------------------------------------
# Multiple instances (optional). The bare OPENBIS_* vars above define an
# instance named "default". Define extra servers with an OPENBIS_<NAME>_*
# prefix; the lower-cased <NAME> is the instance name tools accept via their
# `instance` argument. Each instance supports _TOKEN, _TOKEN_FILE, _USERNAME,
# _PASSWORD, and _VERIFY_CERTIFICATES.
# ---------------------------------------------------------------------------
# OPENBIS_AACHEN_URL=https://openbis.imm.rwth-aachen.de
# OPENBIS_AACHEN_TOKEN=
# OPENBIS_TEST_URL=https://test.openbis.example
# OPENBIS_TEST_TOKEN=
# OPENBIS_TEST_VERIFY_CERTIFICATES=false
#
# Which instance tools use when `instance` is omitted. If unset, the sole
# instance is used, or "default" if present; otherwise tools require `instance`.
# OPENBIS_DEFAULT_INSTANCE=aachen

# ---------------------------------------------------------------------------
# S3 storage (optional — enables create_s3_linked_dataset and
# generate_s3_download_url tools).  Also requires OPENBIS_MCP_ALLOW_WRITE=1
# for the write tool.
#
# Either set all S3_* env vars below, OR point S3_CONFIG_FILE at an INI-style
# config file that has [s3] and [openbis] sections (same format used by
# pybis_aixtended / pyiron_rdm).  The config file takes precedence.
# ---------------------------------------------------------------------------

# Path to an INI config file (optional; overrides the individual vars below)
# S3_CONFIG_FILE=/path/to/s3_config.ini

# S3-compatible object store credentials
# S3_ACCESS_KEY=
# S3_ACCESS_SECRET=
# S3_BUCKET=my-bucket
# S3_REGION=eu-central-1

# Custom endpoint for non-AWS S3-compatible stores (omit for AWS)
# S3_ENDPOINT_URL=https://s3.example.com
# S3_ENDPOINT_PORT=443

# openBIS External Data Management System code registered for this S3 bucket.
# Must be configured by an openBIS admin before use.
# S3_DMS_CODE=MY_DMS
