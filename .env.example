# Copy to .env and fill in. Never commit a populated .env.

OPENBIS_URL=https://openbis.imm.rwth-aachen.de

# Preferred: personal access token (PAT) created in the openBIS web UI
# under: User -> Personal Access Tokens
OPENBIS_TOKEN=

# Alternative: path to a file containing the token on its own line.
# Matches the pyBIS convention of ~/.pybis/<host>.token. Used only if
# OPENBIS_TOKEN is empty.
# OPENBIS_TOKEN_FILE=~/.pybis/openbis.imm.rwth-aachen.de.token

# Fallback: username + password (only used if no token is available)
# OPENBIS_USERNAME=
# OPENBIS_PASSWORD=

# Set to "false" only for development against a self-signed cert.
OPENBIS_VERIFY_CERTIFICATES=true

# Enable create / update / delete tools. OFF by default — the server runs
# read-only unless this is explicitly set to "1".
# OPENBIS_MCP_ALLOW_WRITE=1
